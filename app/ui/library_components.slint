import { Theme } from "theme.slint";
import { VersionTile, ArchiveTile, CuratedTile } from "types.slint";
import { AppButton, Card, Pill } from "components.slint";

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> danger;
    in property <bool> active: true;
    callback clicked();

    width: 30px;
    height: 30px;
    border-radius: Theme.radius-input;
    opacity: root.active ? 1.0 : 0.4;
    background: root.active && ta.has-hover ? (root.danger ? Theme.error.with-alpha(0.35) : Theme.hover) : transparent;
    animate background { duration: 100ms; }
    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: root.icon;
        colorize: root.danger && ta.has-hover ? Theme.error : Theme.text-secondary;
    }
    ta := TouchArea {
        enabled: root.active;
        mouse-cursor: root.active ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

export component VersionCard inherits Card {
    in property <VersionTile> tile;
    in property <bool> busy;
    callback launch();
    callback browse();
    callback rename();
    callback archive();
    callback delete();

    VerticalLayout {
        padding: 16px;
        padding-bottom: 10px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            Text { text: root.tile.name; color: Theme.text-primary; font-size: 16px; font-weight: 700; overflow: elide; horizontal-stretch: 1; }
            if root.tile.missing : Pill { text: "FILES NOT FOUND"; tint: Theme.warning; }
        }
        Text { text: "Manifest " + root.tile.manifest; color: Theme.text-faint; font-size: 12px; overflow: elide; }
        Text { text: root.tile.date == "" ? "Download date unknown" : "Downloaded " + root.tile.date; color: Theme.text-muted; font-size: 12px; }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Last played: " + root.tile.played; color: Theme.text-tertiary; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
            if root.tile.eac : Pill { text: "EAC"; tint: Theme.success; }
        }
        HorizontalLayout {
            spacing: 4px;
            AppButton {
                text: "Launch";
                height: 30px;
                min-width: 80px;
                active: !root.tile.missing;
                clicked => { root.launch(); }
            }
            Rectangle { horizontal-stretch: 1; }
            IconButton { icon: @image-url("icons/folder-open.svg"); active: !root.tile.missing; clicked => { root.browse(); } }
            IconButton { icon: @image-url("icons/pencil-simple.svg"); active: !root.busy; clicked => { root.rename(); } }
            IconButton { icon: @image-url("icons/archive.svg"); active: !root.busy && !root.tile.missing; clicked => { root.archive(); } }
            IconButton { icon: @image-url("icons/trash.svg"); danger: true; active: !root.busy; clicked => { root.delete(); } }
        }
    }
}

export component ArchiveRow inherits Card {
    in property <ArchiveTile> archive;
    in property <bool> busy;
    callback restore();
    callback delete();
    height: 64px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text { text: root.archive.name; color: Theme.text-primary; font-size: 15px; font-weight: 700; overflow: elide; }
            Text { text: root.archive.size; color: Theme.text-muted; font-size: 12px; }
        }
        Rectangle {
            width: 100px;
            AppButton {
                y: (parent.height - self.height) / 2;
                text: "Restore";
                height: 32px;
                active: !root.busy;
                clicked => { root.restore(); }
            }
        }
        Rectangle {
            width: 30px;
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: @image-url("icons/trash.svg");
                danger: true;
                active: !root.busy;
                clicked => { root.delete(); }
            }
        }
    }
}

export component CuratedRow inherits Card {
    in property <CuratedTile> build;
    in property <bool> can-download: true;
    callback download();
    height: 64px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text { text: root.build.title; color: Theme.text-primary; font-size: 15px; font-weight: 700; overflow: elide; }
            Text { text: "Client " + root.build.client + "  ·  Bundles " + root.build.bundle; color: Theme.text-faint; font-size: 12px; overflow: elide; }
        }
        Text { text: root.build.date; color: Theme.text-muted; font-size: 13px; vertical-alignment: center; }
        Rectangle {
            width: 120px;
            AppButton {
                y: (parent.height - self.height) / 2;
                text: "Download";
                height: 32px;
                active: root.can-download;
                clicked => { root.download(); }
            }
        }
    }
}

// A single-line text box in the app's style.
export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    // Hide the typed characters (passwords).
    in property <bool> password;
    callback accepted();
    public function focus-input() { input.focus(); }

    height: 38px;
    border-radius: Theme.radius-input;
    background: #00000066;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.accent-border;
    animate border-color { duration: 100ms; }
    input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        vertical-alignment: center;
        color: Theme.text-primary;
        font-size: 14px;
        selection-background-color: Theme.accent;
        selection-foreground-color: white;
        input-type: root.password ? InputType.password : InputType.text;
        text <=> root.text;
        accepted => { root.accepted(); }
    }
    if root.text == "" && !input.has-focus : Text {
        x: 12px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.text-disabled;
        font-size: 14px;
        vertical-alignment: center;
    }
}

// Progress strip shown while a long job (archive, restore, delete) runs.
export component TaskBanner inherits Rectangle {
    in property <string> text;
    in property <float> progress; // 0..1, negative = unknown
    in property <bool> cancellable;
    callback cancel();

    height: 60px;
    background: Theme.surface-1;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.accent-border;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 9px;
            Text { text: root.text; color: Theme.text-primary; font-size: 13px; overflow: elide; }
            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: #ffffff1f;
                Rectangle {
                    x: 0px;
                    width: root.progress < 0 ? parent.width * 0.25 : parent.width * Math.min(root.progress, 1.0);
                    border-radius: 2px;
                    background: Theme.accent;
                    animate width { duration: 150ms; }
                }
            }
        }
        if root.cancellable : Rectangle {
            width: 80px;
            AppButton {
                y: (parent.height - self.height) / 2;
                text: "Cancel";
                primary: false;
                height: 30px;
                min-width: 70px;
                clicked => { root.cancel(); }
            }
        }
    }
}

// A list that opens above the quick-launch bar, for choosing which version it launches.
export component VersionMenu inherits Rectangle {
    in property <[VersionTile]> versions;
    in property <string> selected-id;
    callback picked(string);
    callback dismissed();

    TouchArea { clicked => { root.dismissed(); } }
    Rectangle {
        x: 24px;
        y: parent.height - Theme.footer-height - self.height - 8px;
        width: 360px;
        height: Math.min(root.versions.length * 40px + 16px, 360px);
        background: Theme.surface-2;
        border-radius: Theme.radius-card;
        border-width: 1px;
        border-color: Theme.accent-border;
        TouchArea { }
        Flickable {
            content-height: root.versions.length * 40px + 16px;
            for v[i] in root.versions : Rectangle {
                x: 8px;
                y: 8px + i * 40px;
                width: parent.width - 16px;
                height: 40px;
                border-radius: 8px;
                background: v.id == root.selected-id ? Theme.accent-soft : (item.has-hover ? Theme.hover : transparent);
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    Text { text: v.name; color: Theme.text-primary; font-size: 14px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    Text { text: v.played == "Never" ? "" : v.played; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                }
                item := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.picked(v.id); }
                }
            }
        }
    }
}
