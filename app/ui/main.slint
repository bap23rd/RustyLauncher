import { Theme } from "theme.slint";
import { VersionTile, ArchiveTile, PathRow, CuratedTile, DownloadRow, UnfinishedRow, ServerTile, ServerConfig, ConfigField } from "types.slint";
import { NavItem, QuickLaunch, Toast, Atmosphere } from "components.slint";
import { TaskBanner, VersionMenu } from "library_components.slint";
import { Modal } from "dialogs.slint";
import { SignInDialog } from "download_components.slint";
import { ServerConfigDialog } from "server_components.slint";
import { TitleBar } from "titlebar.slint";
import { HomePage } from "pages/home.slint";
import { LibraryPage } from "pages/library.slint";
import { DownloadPage } from "pages/download.slint";
import { ServersPage } from "pages/servers.slint";
import { SettingsPage } from "pages/settings.slint";

export { VersionTile, ArchiveTile, PathRow, CuratedTile, DownloadRow, UnfinishedRow, ServerTile, ServerConfig, ConfigField }

export component App inherits Window {
    title: "RustyLauncher";
    // We draw our own title bar (see titlebar.slint). The 6px border is the grab area for resizing.
    no-frame: true;
    resize-border-width: 6px;
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.primary;
    default-font-family: Theme.font;

    // Navigation: "home" | "library" | "download" | "servers" | "settings"
    in-out property <string> page: "home";
    // Background: red by default, blue on the Servers page. Settings keeps whichever was last shown.
    property <bool> blue-atmosphere: false;
    changed page => {
        if (root.page == "servers") {
            root.blue-atmosphere = true;
        } else if (root.page != "settings") {
            root.blue-atmosphere = false;
        }
    }

    // ---- Data from Rust ----
    in property <[VersionTile]> versions;
    in property <[ArchiveTile]> archives;
    in property <[PathRow]> path-rows;
    in property <[CuratedTile]> curated-recommended;
    in property <[CuratedTile]> curated-other;
    in property <string> curated-status;
    in property <int> server-count;
    // The version the quick-launch bar launches (last played, or one the user picked).
    in property <string> selected-id;
    in property <string> last-played-name;
    in property <string> last-played-detail;
    in property <bool> has-last-played;
    in-out property <bool> launch-with-eac: true;
    in property <string> data-dir;
    in property <string> app-version;

    // ---- Servers ----
    in property <[ServerTile]> servers;
    in property <[CuratedTile]> curated-servers;
    // The server settings dialog.
    in-out property <bool> config-open;
    in-out property <string> config-title;
    in-out property <string> config-error;
    in-out property <string> config-server-id;
    in-out property <ServerConfig> server-cfg;

    // ---- Steam account and downloads ----
    // Empty when not signed in.
    in property <string> steam-account;
    in property <[DownloadRow]> downloads;
    in property <[UnfinishedRow]> unfinished;
    in property <string> download-dir;
    // The strip shown above the footer while a download runs.
    in property <bool> download-active;
    in property <string> download-text;
    in property <float> download-progress: -1;
    // The Download and Servers pages show downloads in full, so the strip is only for the other pages.
    property <bool> show-download-strip: root.download-active && root.page != "download" && root.page != "servers";
    // Sign-in dialog. State: "form" | "working" | "guard" | "mobile" | "error".
    in-out property <bool> signin-open;
    in-out property <string> signin-state: "form";
    in-out property <string> signin-message;
    in-out property <string> signin-guard-kind: "authenticator";
    in-out property <bool> signin-phone;
    in-out property <string> signin-username;
    in-out property <string> signin-password;
    in-out property <string> signin-code;

    // A long job (archive, restore, delete, scan) is running.
    in property <bool> task-active;
    in property <string> task-text;
    in property <float> task-progress: -1;
    in property <bool> task-cancellable;

    // ---- Toast + dialog state ----
    in-out property <bool> toast-shown;
    in-out property <string> toast-text;
    in-out property <string> toast-kind: "info";
    in-out property <bool> dialog-open;
    in-out property <string> dialog-title;
    in-out property <string> dialog-body;
    in-out property <string> dialog-confirm: "Confirm";
    in-out property <bool> dialog-danger;
    in-out property <bool> dialog-has-input;
    in-out property <string> dialog-input;
    in-out property <string> dialog-kind;
    in-out property <string> dialog-arg;
    in-out property <bool> menu-open;

    // ---- Requests to Rust ----
    callback launch-version(string);
    callback launch-selected();
    callback pick-version(string);
    callback eac-changed(bool);
    callback browse-version(string);
    callback restore-archive(string);
    callback rescan();
    callback add-install-path();
    callback cancel-task();
    callback install-server-latest(string);
    callback install-server-pinned(string, string, string);
    callback configure-server(string);
    callback save-server-config();
    callback new-server-password();
    callback browse-server(string);
    callback server-mods(string);
    callback update-server(string);
    callback signin-submit(string, string);
    callback signin-code-submit(string);
    callback signin-cancel();
    callback sign-out();
    callback download-build(CuratedTile);
    callback start-manual-download(string, string, string);
    callback cancel-download(int);
    callback resume-download(string);
    callback change-download-dir();
    callback open-url(string);
    callback close-clicked();
    // A confirmed dialog: kind ("rename", "delete", ...), the id it was about, and any text typed.
    callback dialog-confirmed(string, string, string);

    public function show-toast(text: string, kind: string) {
        root.toast-text = text;
        root.toast-kind = kind;
        root.toast-shown = true;
    }
    // Closing the window while a download runs: ask first.
    public function ask-quit() {
        root.ask("quit", "", "Quit RustyLauncher?",
            "A download is still running. If you quit now it stops, and you can resume it next time from the Download page.",
            "Quit", true);
    }
    public function open-signin() {
        root.signin-state = "form";
        root.signin-message = "";
        root.signin-password = "";
        root.signin-code = "";
        root.signin-open = true;
    }
    function ask(kind: string, arg: string, title: string, body: string, confirm: string, danger: bool) {
        root.dialog-kind = kind;
        root.dialog-arg = arg;
        root.dialog-title = title;
        root.dialog-body = body;
        root.dialog-confirm = confirm;
        root.dialog-danger = danger;
        root.dialog-has-input = false;
        root.dialog-open = true;
    }
    function ask-text(kind: string, arg: string, title: string, initial: string, confirm: string) {
        root.dialog-kind = kind;
        root.dialog-arg = arg;
        root.dialog-title = title;
        root.dialog-body = "";
        root.dialog-confirm = confirm;
        root.dialog-danger = false;
        root.dialog-has-input = true;
        root.dialog-input = initial;
        root.dialog-open = true;
    }

    Timer {
        interval: 4s;
        running: root.toast-shown;
        triggered => { root.toast-shown = false; }
    }

    Atmosphere {
        width: parent.width;
        height: parent.height;
        blue: root.blue-atmosphere;
    }

    VerticalLayout {
        TitleBar {
            maximized: root.maximized;
            minimize => { root.minimized = true; }
            toggle-maximize => { root.maximized = !root.maximized; }
            close => { root.close-clicked(); }
        }

        HorizontalLayout {
            // Sidebar
            Rectangle {
                width: Theme.sidebar-width;
                background: Theme.surface-sidebar;
                VerticalLayout {
                    padding: 16px;
                    spacing: 4px;
                    Text {
                        text: "RUSTYLAUNCHER";
                        color: Theme.accent;
                        font-size: 16px;
                        font-weight: 800;
                        height: 48px;
                        vertical-alignment: center;
                    }
                    NavItem { label: "Home"; icon: @image-url("icons/house.svg"); active: root.page == "home"; clicked => { root.page = "home"; } }
                    Text { text: "GAME"; color: Theme.text-faint; font-size: 11px; font-weight: 700; height: 28px; vertical-alignment: bottom; x: 6px; }
                    NavItem { label: "Library"; icon: @image-url("icons/book-open.svg"); indent: 8px; active: root.page == "library"; clicked => { root.page = "library"; } }
                    NavItem { label: "Download"; icon: @image-url("icons/download-simple.svg"); indent: 8px; active: root.page == "download"; clicked => { root.page = "download"; } }
                    Text { text: "SERVERS"; color: Theme.text-faint; font-size: 11px; font-weight: 700; height: 28px; vertical-alignment: bottom; x: 6px; }
                    NavItem { label: "Servers"; icon: @image-url("icons/hard-drives.svg"); indent: 8px; active: root.page == "servers"; clicked => { root.page = "servers"; } }
                    Rectangle { vertical-stretch: 1; }
                    NavItem { label: "Settings"; icon: @image-url("icons/gear-six.svg"); active: root.page == "settings"; clicked => { root.page = "settings"; } }
                }
            }

            // Content + quick-launch footer
            VerticalLayout {
                Rectangle {
                    vertical-stretch: 1;
                    if root.page == "home" : HomePage {
                        width: parent.width;
                        height: parent.height;
                        last-played-name: root.has-last-played ? root.last-played-name : "Nothing yet";
                        last-played-detail: root.last-played-detail;
                        version-count: root.versions.length;
                        server-count: root.server-count;
                        go-download => { root.page = "download"; }
                    }
                    if root.page == "library" : LibraryPage {
                        width: parent.width;
                        height: parent.height;
                        versions: root.versions;
                        archives: root.archives;
                        busy: root.task-active;
                        go-download => { root.page = "download"; }
                        launch(id) => { root.launch-version(id); }
                        browse(id) => { root.browse-version(id); }
                        rename(v) => { root.ask-text("rename", v.id, "Rename version", v.name, "Rename"); }
                        archive(v) => {
                            root.ask("archive", v.id, "Archive " + v.name + "?",
                                "Packs the version into one file in the archive folder, checks it, then removes the original folder. You can restore it later from the Archived tab.",
                                "Archive", false);
                        }
                        delete(v) => {
                            root.ask("delete", v.id, "Delete " + v.name + "?",
                                "This permanently deletes the version and all its files from disk. It cannot be undone.",
                                "Delete", true);
                        }
                        restore(a) => { root.restore-archive(a.path); }
                        delete-archive(a) => {
                            root.ask("delete-archive", a.path, "Delete the archive " + a.name + "?",
                                "This permanently deletes the archive file. It cannot be undone.",
                                "Delete", true);
                        }
                        rescan => { root.rescan(); }
                    }
                    if root.page == "download" : DownloadPage {
                        width: parent.width;
                        height: parent.height;
                        recommended: root.curated-recommended;
                        other: root.curated-other;
                        status: root.curated-status;
                        downloads: root.downloads;
                        unfinished: root.unfinished;
                        download-dir: root.download-dir;
                        steam-account: root.steam-account;
                        busy: root.task-active || root.download-active;
                        sign-in => { root.open-signin(); }
                        change-dir => { root.change-download-dir(); }
                        open-url(u) => { root.open-url(u); }
                        cancel-download(id) => { root.cancel-download(id); }
                        resume(p) => { root.resume-download(p); }
                        discard(u) => {
                            root.ask("discard-download", u.path, "Discard this unfinished download?",
                                u.name + "\n\nThe files downloaded so far are deleted. You can download the build again later.",
                                "Discard", true);
                        }
                        download-build(b) => {
                            root.ask("download", b.client + "|" + b.bundle + "|" + b.title, "Download " + b.title + "?",
                                (root.download-dir == "" ? "You have not chosen a download folder yet. Choose one first." : "It will be saved in " + root.download-dir + ".")
                                + "\n\nRust builds are large, often 20 GB or more, and take a while. You can keep using the launcher meanwhile.",
                                "Download", false);
                        }
                        start-manual(name, client, bundles) => {
                            root.ask("download", client + "|" + bundles + "|" + name, "Download this build?",
                                "Game files " + client + "\nBundles " + bundles + "\n\nBoth must come from the same Steam update, or the game may not start.",
                                "Download", false);
                        }
                    }
                    if root.page == "servers" : ServersPage {
                        width: parent.width;
                        height: parent.height;
                        servers: root.servers;
                        curated: root.curated-servers;
                        downloads: root.downloads;
                        download-dir: root.download-dir;
                        steam-account: root.steam-account;
                        busy: root.task-active || root.download-active;
                        install-curated(b) => {
                            root.ask("download-server", b.client + "|" + b.bundle + "|" + b.title, "Install " + b.title + "?",
                                (root.download-dir == "" ? "You have not chosen an install folder yet. Choose one first." : "It will be saved in " + root.download-dir + ".")
                                + "\n\nThe server is about 5 GB. Older builds need you to be signed in to Steam.",
                                "Install", false);
                        }
                        install-latest(name) => { root.install-server-latest(name); }
                        install-pinned(name, w, c) => { root.install-server-pinned(name, w, c); }
                        configure(id) => { root.configure-server(id); }
                        browse(id) => { root.browse-server(id); }
                        mods(id) => { root.server-mods(id); }
                        update(id) => { root.update-server(id); }
                        rename(s) => { root.ask-text("rename-server", s.id, "Rename server", s.name, "Rename"); }
                        delete(s) => {
                            root.ask("delete-server", s.id, "Delete " + s.name + "?",
                                "This permanently deletes the server and everything in its folder, including its world saves. It cannot be undone.",
                                "Delete", true);
                        }
                        change-dir => { root.change-download-dir(); }
                        sign-in => { root.open-signin(); }
                        cancel-download(id) => { root.cancel-download(id); }
                        open-url(u) => { root.open-url(u); }
                    }
                    if root.page == "settings" : SettingsPage {
                        width: parent.width;
                        height: parent.height;
                        data-dir: root.data-dir;
                        app-version: root.app-version;
                        steam-account: root.steam-account;
                        sign-in => { root.open-signin(); }
                        sign-out => { root.sign-out(); }
                        path-rows: root.path-rows;
                        busy: root.task-active;
                        add-path => { root.add-install-path(); }
                        remove-path(p) => {
                            root.ask("remove-path", p, "Stop watching this folder?",
                                p + "\n\nYour files stay where they are. The versions found there are removed from the library until you add the folder again.",
                                "Remove", false);
                        }
                        rescan => { root.rescan(); }
                        archive-all => {
                            root.ask("archive-all", "", "Archive every version?",
                                "Each version is packed into a file in its archive folder, checked, then its folder is removed. This can take a long time and needs free disk space for the archives.",
                                "Archive all", false);
                        }
                        delete-all => {
                            root.ask("delete-all", "", "Delete every version?",
                                "This permanently deletes ALL installed versions and their files from disk. Archives are kept. It cannot be undone.",
                                "Delete all", true);
                        }
                        test-toast => { root.show-toast("This is a notification.", "success"); }
                        test-dialog => { root.ask("test", "", "Dialog test", "This is the shared confirmation dialog.", "OK", false); }
                    }
                }
                QuickLaunch {
                    height: Theme.footer-height;
                    has-version: root.has-last-played;
                    can-switch: root.versions.length > 1;
                    version-name: root.last-played-name;
                    detail: root.last-played-detail;
                    eac: root.launch-with-eac;
                    launch => { root.launch-selected(); }
                    switch-clicked => { root.menu-open = true; }
                    eac-toggled(on) => { root.launch-with-eac = on; root.eac-changed(on); }
                }
            }
        }
    }

    if root.menu-open : VersionMenu {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        versions: root.versions;
        selected-id: root.selected-id;
        picked(id) => { root.menu-open = false; root.pick-version(id); }
        dismissed => { root.menu-open = false; }
    }

    if root.task-active : TaskBanner {
        x: Theme.sidebar-width + 24px;
        y: parent.height - Theme.footer-height - self.height - 16px;
        width: parent.width - Theme.sidebar-width - 48px;
        text: root.task-text;
        progress: root.task-progress;
        cancellable: root.task-cancellable;
        cancel => { root.cancel-task(); }
    }

    if root.show-download-strip : TaskBanner {
        x: Theme.sidebar-width + 24px;
        y: parent.height - Theme.footer-height - self.height - 16px - (root.task-active ? 76px : 0px);
        width: parent.width - Theme.sidebar-width - 48px;
        text: root.download-text;
        progress: root.download-progress;
        cancellable: true;
        cancel => { root.cancel-download(-1); }
    }

    Toast {
        x: parent.width - self.width - 24px;
        y: parent.height - Theme.footer-height - self.height - 16px - (root.task-active ? 76px : 0px) - (root.show-download-strip ? 76px : 0px);
        text: root.toast-text;
        kind: root.toast-kind;
        shown: root.toast-shown;
    }

    Modal {
        width: parent.width;
        height: parent.height;
        open: root.dialog-open;
        title: root.dialog-title;
        body: root.dialog-body;
        confirm-text: root.dialog-confirm;
        danger: root.dialog-danger;
        has-input: root.dialog-has-input;
        input-text <=> root.dialog-input;
        confirmed => {
            root.dialog-open = false;
            root.dialog-confirmed(root.dialog-kind, root.dialog-arg, root.dialog-input);
        }
        cancelled => { root.dialog-open = false; }
    }

    ServerConfigDialog {
        width: parent.width;
        height: parent.height;
        open: root.config-open;
        title: root.config-title;
        error: root.config-error;
        cfg <=> root.server-cfg;
        save => { root.save-server-config(); }
        cancel => { root.config-open = false; }
        new-password => { root.new-server-password(); }
    }

    SignInDialog {
        width: parent.width;
        height: parent.height;
        open: root.signin-open;
        state: root.signin-state;
        message: root.signin-message;
        guard-kind: root.signin-guard-kind;
        phone: root.signin-phone;
        username <=> root.signin-username;
        password <=> root.signin-password;
        code <=> root.signin-code;
        submit(user, pass) => { root.signin-submit(user, pass); root.signin-password = ""; }
        submit-code(c) => { root.signin-code-submit(c); root.signin-code = ""; }
        cancel => { root.signin-cancel(); }
        retry => { root.open-signin(); }
    }

    // Thin outline so the frameless window has an edge (hidden when maximised).
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;
        border-width: root.maximized ? 0px : 1px;
        border-color: Theme.accent-border;
    }
}
