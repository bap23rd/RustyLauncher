// Plain data passed from Rust to the UI.
export struct VersionTile {
    id: string,
    name: string,
    manifest: string,
    date: string,
    played: string,
    eac: bool,
    // The game's files are not at the recorded location (moved or drive unplugged).
    missing: bool,
}

export struct ArchiveTile {
    name: string,
    size: string,
    path: string,
}

export struct PathRow {
    path: string,
    usage: string,
}

export struct CuratedTile {
    title: string,
    date: string,
    client: string,
    bundle: string,
}

// A download that is running or waiting.
export struct DownloadRow {
    id: int,
    name: string,
    status: string,
    // 0..1, or negative while the size is still unknown.
    progress: float,
    active: bool,
}

// A download that was started but not finished (can be resumed).
export struct UnfinishedRow {
    path: string,
    name: string,
    detail: string,
}

// One installed dedicated server.
export struct ServerTile {
    id: string,
    name: string,
    // "latest" or "pinned"
    kind: string,
    manifest: string,
    created: string,
    oxide: bool,
    missing: bool,
}

// A launch setting with an on/off switch.
export struct ConfigField {
    enabled: bool,
    value: string,
}

// The server launch settings (V2's fields).
export struct ServerConfig {
    hostname: ConfigField,
    identity: ConfigField,
    port: ConfigField,
    rcon-port: ConfigField,
    rcon-password: ConfigField,
    rcon-web: bool,
    max-players: ConfigField,
    world-size: ConfigField,
    seed: ConfigField,
    save-interval: ConfigField,
    custom-args: string,
}
