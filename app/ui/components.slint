import { Theme } from "theme.slint";
import { VersionTile } from "types.slint";

export component AppButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: true;
    in property <bool> active: true;
    callback clicked();

    height: 36px;
    min-width: 96px;
    border-radius: Theme.radius-button;
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.accent-border;
    opacity: root.active ? 1.0 : 0.45;
    background: !root.active ? #ffffff10
        : root.primary ? (ta.has-hover ? Theme.accent-hover : Theme.accent)
        : (ta.has-hover ? Theme.hover : transparent);
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        Text {
            text: root.text;
            color: Theme.text-primary;
            font-size: 14px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.active;
        mouse-cursor: root.active ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

export component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active;
    in property <length> indent: 0px;
    callback clicked();

    height: 40px;
    border-radius: 8px;
    background: root.active ? Theme.accent-soft : (ta.has-hover ? Theme.hover : transparent);
    animate background { duration: 120ms; }

    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 20px;
        border-radius: 2px;
        background: root.active ? Theme.accent : transparent;
    }
    HorizontalLayout {
        padding-left: 16px + root.indent;
        spacing: 12px;
        alignment: start;
        Rectangle {
            width: 18px;
            Image {
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                source: root.icon;
                colorize: root.active ? Theme.text-primary : Theme.text-secondary;
            }
        }
        Text {
            text: root.label;
            color: root.active ? Theme.text-primary : Theme.text-secondary;
            font-size: 14px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 4px;
    Text { text: root.title; color: Theme.text-primary; font-size: 26px; font-weight: 700; }
    Text { text: root.subtitle; color: Theme.text-muted; font-size: 14px; }
}

export component Card inherits Rectangle {
    background: Theme.surface-card;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.accent-border-strong;
}

export component StatCard inherits Card {
    in property <string> label;
    in property <string> value;
    in property <string> detail;
    VerticalLayout {
        padding: 18px;
        spacing: 4px;
        Text { text: root.label; color: Theme.text-muted; font-size: 12px; font-weight: 600; }
        Text { text: root.value; color: Theme.text-primary; font-size: 24px; font-weight: 700; overflow: elide; }
        Text { text: root.detail; color: Theme.text-tertiary; font-size: 12px; overflow: elide; }
    }
}

export component Pill inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.success;
    height: 22px;
    border-radius: Theme.radius-pill;
    background: root.tint.with-alpha(0.18);
    border-width: 1px;
    border-color: root.tint.with-alpha(0.5);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text { text: root.text; color: root.tint; font-size: 11px; font-weight: 700; vertical-alignment: center; }
    }
}

export component VersionCard inherits Card {
    in property <VersionTile> tile;
    border-color: ta.has-hover ? Theme.accent : Theme.accent-border-strong;
    animate border-color { duration: 120ms; }
    VerticalLayout {
        padding: 16px;
        spacing: 4px;
        Text { text: root.tile.name; color: Theme.text-primary; font-size: 16px; font-weight: 700; overflow: elide; }
        Text { text: "Manifest " + root.tile.manifest; color: Theme.text-faint; font-size: 12px; overflow: elide; }
        Text { text: root.tile.date == "" ? "Download date unknown" : "Downloaded " + root.tile.date; color: Theme.text-muted; font-size: 12px; }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Last played: " + root.tile.played; color: Theme.text-tertiary; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
            if root.tile.eac : Pill { text: "EAC"; tint: Theme.success; }
        }
    }
    ta := TouchArea { }
}

export component EmptyState inherits Card {
    in property <string> title;
    in property <string> body;
    in property <string> action;
    callback action-clicked();
    VerticalLayout {
        alignment: center;
        spacing: 10px;
        padding: 32px;
        Text { text: root.title; color: Theme.text-primary; font-size: 18px; font-weight: 700; horizontal-alignment: center; }
        Text { text: root.body; color: Theme.text-muted; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
        if root.action != "" : HorizontalLayout {
            alignment: center;
            padding-top: 6px;
            AppButton { text: root.action; clicked => { root.action-clicked(); } }
        }
    }
}

// Quick-launch ribbon along the bottom (last played version, EAC switch, launch).
export component QuickLaunch inherits Rectangle {
    in property <string> version-name;
    in property <string> detail;
    in property <bool> has-version;
    in-out property <bool> eac: true;
    callback launch();
    callback eac-toggled(bool);

    background: Theme.surface-overlay;
    border-width: 0px;

    Rectangle {
        y: 0px;
        height: 1px;
        background: Theme.accent-border;
    }
    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 20px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text { text: root.has-version ? root.version-name : "No game version yet"; color: Theme.text-primary; font-size: 14px; font-weight: 600; overflow: elide; }
            Text { text: root.detail; color: Theme.text-muted; font-size: 12px; overflow: elide; }
        }
        // EAC switch
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 10px;
            Text { text: "Easy Anti-Cheat"; color: Theme.text-secondary; font-size: 13px; vertical-alignment: center; }
            Rectangle {
                width: 42px;
                height: 22px;
                y: (parent.height - self.height) / 2;
                border-radius: 11px;
                background: root.eac ? Theme.accent : #ffffff26;
                animate background { duration: 120ms; }
                Rectangle {
                    x: root.eac ? parent.width - self.width - 3px : 3px;
                    y: 3px;
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: white;
                    animate x { duration: 120ms; }
                }
                TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.eac = !root.eac;
                        root.eac-toggled(root.eac);
                    }
                }
            }
        }
        AppButton {
            y: (parent.height - self.height) / 2;
            text: "Launch";
            active: root.has-version;
            clicked => { root.launch(); }
        }
    }
}

export component Toast inherits Rectangle {
    in property <string> text;
    in property <string> kind; // "info" | "success" | "error"
    in property <bool> shown;

    width: 360px;
    height: 48px;
    visible: self.opacity > 0.01;
    opacity: root.shown ? 1.0 : 0.0;
    animate opacity { duration: 180ms; }
    background: Theme.surface-1;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: root.kind == "error" ? Theme.error : root.kind == "success" ? Theme.success : Theme.accent-border;

    Rectangle {
        x: 0px;
        width: 4px;
        border-top-left-radius: Theme.radius-card;
        border-bottom-left-radius: Theme.radius-card;
        background: root.kind == "error" ? Theme.error : root.kind == "success" ? Theme.success : Theme.accent;
    }
    Text {
        x: 20px;
        width: parent.width - 32px;
        text: root.text;
        color: Theme.text-primary;
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component Modal inherits Rectangle {
    in property <bool> open;
    in property <string> title;
    in property <string> body;
    in property <string> confirm-text: "Confirm";
    callback confirmed();
    callback cancelled();

    visible: root.open;
    // Backdrop: also swallows clicks so nothing underneath is reachable.
    Rectangle {
        background: #000000b3;
        TouchArea { clicked => { root.cancelled(); } }
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 440px;
        height: panel.preferred-height;
        background: Theme.surface-2;
        border-radius: Theme.radius-card;
        border-width: 1px;
        border-color: Theme.accent-border;
        TouchArea { } // clicks on the panel must not reach the backdrop
        panel := VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Text { text: root.title; color: Theme.text-primary; font-size: 18px; font-weight: 700; }
            Text { text: root.body; color: Theme.text-secondary; font-size: 14px; wrap: word-wrap; }
            HorizontalLayout {
                padding-top: 8px;
                spacing: 10px;
                alignment: end;
                AppButton { text: "Cancel"; primary: false; clicked => { root.cancelled(); } }
                AppButton { text: root.confirm-text; clicked => { root.confirmed(); } }
            }
        }
    }
}

// The window background: a diagonal gradient from the accent colour into the dark brown,
// under a dark overlay so text stays readable. "Red" is the default; "blue" cross-fades in.
export component Atmosphere inherits Rectangle {
    in property <bool> blue;

    Rectangle { background: @linear-gradient(135deg, Theme.accent 0%, Theme.primary 100%); }
    Rectangle {
        background: @linear-gradient(135deg, Theme.info 0%, Theme.primary 100%);
        opacity: root.blue ? 1.0 : 0.0;
        animate opacity { duration: 600ms; easing: ease-in-out; }
    }
    Rectangle { background: #281C1Cb3; }
}
